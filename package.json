{
    "name": "sitespeak",
    "version": "0.1.0",
    "private": true,
    "description": "SiteSpeak — hands-free field safety & incident reporting voice agent on AssemblyAI Voice Agent API",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev:server": "npm run dev --workspace apps/server",
        "dev:client": "npm run dev --workspace apps/client",
        "build": "npm run build --workspaces --if-present",
        "start": "npm run start --workspace apps/server",
        "seed": "npm run seed --workspace apps/server"
    },
    "license": "MIT"
}